{
	"format_version": "1.8.0",
	"animations": {
		"animation.geyser_block": {
			"loop": true,
			"bones": {
				"block_left": {
					"position": [
						"(v.gb_on ? v.gb_tx : q.property('geyser:t_x'))",
						"(v.gb_on ? v.gb_ty : q.property('geyser:t_y'))",
						"(v.gb_on ? v.gb_tz : q.property('geyser:t_z'))"
					],
					"rotation": [
						"(v.gb_on ? v.gb_rx : q.property('geyser:r_x'))",
						"(v.gb_on ? v.gb_ry : q.property('geyser:r_y'))",
						"(v.gb_on ? v.gb_rz : q.property('geyser:r_z'))"
					]
				},
				"block_scale": {
					"scale": [
						"(v.gb_on ? v.gb_sx : q.property('geyser:s_x'))",
						"(v.gb_on ? v.gb_sy : q.property('geyser:s_y'))",
						"(v.gb_on ? v.gb_sz : q.property('geyser:s_z'))"
					]
				},
				"block_right": {
					"rotation": [
						"(v.gb_on ? v.gb_qx : q.property('geyser:b_rrx'))",
						"(v.gb_on ? v.gb_qy : q.property('geyser:b_rry'))",
						"(v.gb_on ? v.gb_qz : q.property('geyser:b_rrz'))"
					]
				},
				"block_shape": {
					"position": [
						"(q.property('geyser:bx1') + q.property('geyser:bx2')) / 2",
						"(q.property('geyser:by1') + q.property('geyser:by2')) / 2",
						"-(q.property('geyser:bz1') + q.property('geyser:bz2')) / 2"
					],
					"scale": [
						"(q.property('geyser:bx2') - q.property('geyser:bx1')) / 16",
						"(q.property('geyser:by2') - q.property('geyser:by1')) / 16",
						"(q.property('geyser:bz2') - q.property('geyser:bz1')) / 16"
					]
				}
			}
		}
	}
}